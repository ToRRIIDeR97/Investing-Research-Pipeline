# Database
DATABASE_URL=

# Optional role-driven web discovery. Used when no generic search endpoint is set.
TAVILY_API_KEY=

# Research OS Local Agent Harness Configuration
# Supported providers: direct-openai-compatible | local-openai-compatible | opencode-go-direct | mock
RESEARCH_MODEL_PROVIDER=direct-openai-compatible
RESEARCH_MODEL_BASE_URL=https://api.openai.com/v1
RESEARCH_MODEL_API_KEY=
# Required for direct providers. Comma-separated exact hostnames.
RESEARCH_MODEL_ALLOWED_HOSTS=api.openai.com

# Checkpoint, attempt, and inactivity limits in milliseconds.
RESEARCH_INACTIVITY_TIMEOUT_MS=90000
RESEARCH_AGENT_TIMEOUT_MS=720000
RESEARCH_ATTEMPT_TIMEOUT_MS=360000
RESEARCH_REPAIR_TIMEOUT_MS=180000
RESEARCH_VALUATION_ANALYST_TIMEOUT_MS=960000
RESEARCH_VALUATION_ANALYST_ATTEMPT_TIMEOUT_MS=480000
RESEARCH_MAX_RESPONSE_BYTES=1000000
RESEARCH_MAX_CONTEXT_BYTES=4000000
RESEARCH_MAX_TOOL_OUTPUT_BYTES=50000
RESEARCH_TOOL_TIMEOUT_MS=30000
RESEARCH_MAX_REPEATED_TOOL_CALLS=3
RESEARCH_PROVIDER_HEALTH_TIMEOUT_MS=10000
# Zero or unset omits max_tokens where the provider protocol permits it.
RESEARCH_MAX_OUTPUT_TOKENS=0
RESEARCH_MAX_REPAIR_ATTEMPTS=1
RESEARCH_MAX_MODEL_ATTEMPTS=2
RESEARCH_RETRY_BASE_DELAY_MS=1000
RESEARCH_MAX_TOOL_TURNS=4
RESEARCH_MAX_TOOL_CALLS=8
RESEARCH_ATTEMPT_BUDGET_RESERVE_USD=0.1
# Worker preparation may be bounded up to four; provider API requests are serialized per endpoint.
RESEARCH_AGENT_CONCURRENCY=3
# Keep serialized provider streams until the two-stream paid canary passes.
RESEARCH_PROVIDER_CONCURRENCY=1

# One configured vision-capable model handles text and image requests.
RESEARCH_VISION_MODEL=deepseek-v4-flash-vision-exp

# Source-reader requests are partitioned into resumable, citation-validated batches.
RESEARCH_SOURCE_READER_TIMEOUT_MS=720000
RESEARCH_SOURCE_READER_ATTEMPT_TIMEOUT_MS=360000
RESEARCH_SOURCE_READER_INACTIVITY_TIMEOUT_MS=120000
RESEARCH_SOURCE_READER_MAX_MODEL_ATTEMPTS=2
RESEARCH_SOURCE_READER_BATCH_MAX_CHUNKS=4
RESEARCH_SOURCE_READER_BATCH_MAX_BYTES=16000
# Anthropic-compatible /messages requires max_tokens. This is a protocol
# safety value, not the Research OS harness output ceiling.
RESEARCH_ANTHROPIC_PROTOCOL_MAX_TOKENS=65536
BACKTEST_TIMEOUT_MS=120000
