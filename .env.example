# Database
DATABASE_URL=

# OpenCode sidecar
# Current code calls a local OpenCode sidecar through @opencode-ai/sdk.
# Research OS can sync this key into the local sidecar before agent calls.
OPENCODE_BASE_URL=http://localhost:4096
OPENCODE_GO_PROVIDER_ID=opencode-go
OPENCODE_GO_API_KEY=
# Set true if Research OS should fail fast when OPENCODE_GO_API_KEY is missing.
OPENCODE_REQUIRE_MANAGED_AUTH=false
OPENCODE_MODEL_TIER=premium
BACKTEST_TIMEOUT_MS=120000

# Agent names
OPENCODE_BACKTEST_AGENT=backtest-coder

# Default model routing
# Values may be display names, but OpenCode Go model IDs are preferred.
OPENCODE_CHEAP_MODEL=deepseek-v4-flash
OPENCODE_CHEAP_REASONING=max
OPENCODE_MID_MODEL=deepseek-v4-pro
OPENCODE_MID_REASONING=max
OPENCODE_VISION_MODEL=qwen3.7-plus

# Specialist model routing
OPENCODE_ASSET_ANALYST_MODEL=deepseek-v4-pro
OPENCODE_AGENT_TIMEOUT_MS=240000
OPENCODE_ASSET_ANALYST_FALLBACK_MODEL=qwen3.7-plus
OPENCODE_ASSET_ANALYST_REASONING=max
OPENCODE_VALUATION_ANALYST_MODEL=kimi-k2.7-code
OPENCODE_VALUATION_ANALYST_FALLBACK_MODEL=deepseek-v4-pro
OPENCODE_VALUATION_ANALYST_REASONING=max
OPENCODE_RESEARCH_REVIEWER_MODEL=deepseek-v4-pro
OPENCODE_RESEARCH_REVIEWER_REASONING=max
OPENCODE_VALUATION_CODER_MODEL=kimi-k2.7-code
OPENCODE_VALUATION_CODER_REASONING=max
OPENCODE_BACKTEST_CODER_MODEL=kimi-k2.7-code
OPENCODE_BACKTEST_CODER_REASONING=max
