# Database
DATABASE_URL=postgres://research_os:research_os_dev@127.0.0.1:5432/research_os

# OpenCode sidecar
# Current code can call a local OpenCode sidecar through @opencode-ai/sdk.
# Research OS can sync this key into the local sidecar before agent calls.
OPENCODE_BASE_URL=http://localhost:4096
OPENCODE_GO_PROVIDER_ID=opencode-go
OPENCODE_GO_API_KEY=
# Set true if Research OS should fail fast when OPENCODE_GO_API_KEY is missing.
OPENCODE_REQUIRE_MANAGED_AUTH=true
OPENCODE_MODEL_TIER=premium

# Agent names
OPENCODE_BACKTEST_AGENT=backtest-coder

# OpenCode sidecar model routing
OPENCODE_CHEAP_MODEL="Deepseek V4 Flash"
OPENCODE_CHEAP_REASONING=max
OPENCODE_MID_MODEL="Deepseek V4 Pro"
OPENCODE_MID_REASONING=max
OPENCODE_VISION_MODEL="Qwen 3.7 Plus"
OPENCODE_ASSET_ANALYST_MODEL="GLM 5.2"
OPENCODE_ASSET_ANALYST_REASONING=max
OPENCODE_VALUATION_ANALYST_MODEL="Kimi K2.7 Code"
OPENCODE_VALUATION_ANALYST_REASONING=max
OPENCODE_RESEARCH_REVIEWER_MODEL="Deepseek V4 Pro"
OPENCODE_RESEARCH_REVIEWER_REASONING=max
OPENCODE_VALUATION_CODER_MODEL="Kimi K2.7 Code"
OPENCODE_VALUATION_CODER_REASONING=max
OPENCODE_BACKTEST_CODER_MODEL="Kimi K2.7 Code"
OPENCODE_BACKTEST_CODER_REASONING=max

# Research OS direct agent harness
# Supported providers: direct-openai-compatible | local-openai-compatible | opencode-go-direct | mock
# The current local setup calls OpenCode Go directly without the localhost sidecar.
RESEARCH_MODEL_PROVIDER=opencode-go-direct
RESEARCH_MODEL_BASE_URL=https://opencode.ai/zen/go/v1
# Optional explicit override. opencode-go-direct falls back to OPENCODE_GO_API_KEY.
RESEARCH_MODEL_API_KEY=
# Required for direct providers. Comma-separated exact hostnames.
RESEARCH_MODEL_ALLOWED_HOSTS=opencode.ai

# Inactivity Timeout (MS) - Aborts streaming if no new tokens arrive
RESEARCH_INACTIVITY_TIMEOUT_MS=90000
RESEARCH_AGENT_TIMEOUT_MS=240000
RESEARCH_MAX_RESPONSE_BYTES=1000000
# Zero or unset omits max_tokens where the provider protocol permits it.
RESEARCH_MAX_OUTPUT_TOKENS=0
RESEARCH_MAX_REPAIR_ATTEMPTS=1
RESEARCH_MAX_MODEL_ATTEMPTS=4
RESEARCH_RETRY_BASE_DELAY_MS=1000
RESEARCH_MAX_TOOL_TURNS=4
RESEARCH_MAX_TOOL_CALLS=8
RESEARCH_ATTEMPT_BUDGET_RESERVE_USD=0.1

# Default model routing config
RESEARCH_CHEAP_MODEL=deepseek-v4-flash
RESEARCH_MID_MODEL=deepseek-v4-pro
RESEARCH_VISION_MODEL=qwen3.7-plus

# Specialist model routing config
RESEARCH_ASSET_ANALYST_MODEL=glm-5.2
RESEARCH_ASSET_ANALYST_TIMEOUT_MS=600000
RESEARCH_ASSET_ANALYST_FALLBACK_MODEL=qwen3.7-plus

# Source-reader requests are partitioned into resumable, citation-validated batches.
RESEARCH_SOURCE_READER_TIMEOUT_MS=600000
RESEARCH_SOURCE_READER_MAX_OUTPUT_TOKENS=0
RESEARCH_SOURCE_READER_FALLBACK_MODEL=deepseek-v4-pro
RESEARCH_SOURCE_READER_BATCH_MAX_CHUNKS=8
RESEARCH_SOURCE_READER_BATCH_MAX_BYTES=36000
# Anthropic-compatible /messages requires max_tokens. This is a protocol
# safety value, not the Research OS harness output ceiling.
RESEARCH_ANTHROPIC_PROTOCOL_MAX_TOKENS=65536
RESEARCH_METRIC_NORMALIZER_MODEL=glm-5.2

RESEARCH_VALUATION_ANALYST_MODEL=kimi-k2.7-code
RESEARCH_VALUATION_ANALYST_FALLBACK_MODEL=deepseek-v4-pro

RESEARCH_RESEARCH_REVIEWER_MODEL=deepseek-v4-pro
RESEARCH_VALUATION_CODER_MODEL=kimi-k2.7-code
RESEARCH_BACKTEST_CODER_MODEL=kimi-k2.7-code

BACKTEST_TIMEOUT_MS=120000
