{
  "name": "research-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:integration": "RUN_DB_INTEGRATION=1 tsx --test tests/persistence-integration.test.ts",
    "test:provider-smoke": "tsx scripts/provider-smoke.ts",
    "test:source-reader-smoke": "tsx scripts/source-reader-smoke.ts",
    "test:meli-mock": "tsx scripts/new-meli-run.ts",
    "test:sofi-mock": "RESEARCH_ASSET=SOFI tsx scripts/new-equity-run.ts",
    "test:sofi-v3": "RUN_DB_INTEGRATION=1 DATABASE_URL=postgresql://research_os:research_os_dev@localhost:5433/research_os RESEARCH_MODEL_PROVIDER=mock RESEARCH_ACCEPTANCE_PROVIDER=mock tsx --test tests/sofi-research-e2e.test.ts",
    "test:sofi-backtest": "tsx scripts/test-live-backtester.ts",
    "test:live-backtest": "tsx scripts/test-live-backtester.ts",
    "benchmark:investment": "tsx scripts/benchmark-investment.ts",
    "run:research:resume": "tsx scripts/resume-research-run.ts",
    "run:meli-direct": "RESEARCH_ACCEPTANCE_PROVIDER=direct-openai-compatible tsx scripts/new-meli-run.ts",
    "worker:research": "tsx src/workers/research-worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "drizzle-orm": "^0.44.2",
    "postgres": "^3.4.5",
    "pg": "^8.16.0",
    "@types/pg": "^8.11.14",
    "zod": "^3.25.67",
    "nanoid": "^5.1.5",
    "date-fns": "^4.1.0",
    "recharts": "^2.15.4",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1",
    "lucide-react": "^0.513.0",
    "marked": "^16.1.1"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "@types/node": "^22.15.34",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.19.4",
    "tailwindcss": "^4.1.11",
    "@tailwindcss/postcss": "^4.1.11",
    "postcss": "^8.5.6",
    "eslint": "^9.29.0",
    "eslint-config-next": "^15.3.3",
    "@eslint/eslintrc": "^3.3.1"
  }
}
